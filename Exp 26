import cv2

# Read video
cap = cv2.VideoCapture("video.mp4")

frames = []

# Store video frames
while True:
    ret, frame = cap.read()

    if not ret:
        break

    frames.append(frame)

cap.release()

# Reverse frames
frames.reverse()

# Display reversed video
for frame in frames:

    cv2.imshow("Reverse Video", frame)

    # Press q to stop
    if cv2.waitKey(40) & 0xFF == ord('q'):
        break

cv2.destroyAllWindows()
