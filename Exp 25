import cv2

# Read images
img = cv2.imread("image.jpg")
template = cv2.imread("watch.jpg")

# Check images
if img is None or template is None:
    print("Error: Image not found!")
    exit()

# Resize template if it is larger than input image
if (template.shape[0] > img.shape[0] or
    template.shape[1] > img.shape[1]):

    template = cv2.resize(
        template,
        (img.shape[1] // 2, img.shape[0] // 2)
    )

# Get template size
h, w = template.shape[:2]

# Apply template matching
result = cv2.matchTemplate(
    img, template, cv2.TM_CCOEFF_NORMED
)

# Find best match
_, max_val, _, max_loc = cv2.minMaxLoc(result)

# Draw rectangle
top_left = max_loc
bottom_right = (top_left[0] + w, top_left[1] + h)

cv2.rectangle(img, top_left, bottom_right, (0, 255, 0), 2)

# Display result
cv2.imshow("Watch Recognition", img)

cv2.waitKey(0)
cv2.destroyAllWindows()
