
import cv2
import matplotlib.pyplot as plt

# Read the original image
img = cv2.imread("image.jpg")

if img is None:
    print("Error: Image not found!")
else:
    # Add watermark text to the image
    watermark = img.copy()

    text = "COPYRIGHT"

    # Set font properties
    font = cv2.FONT_HERSHEY_SIMPLEX
    position = (50, 100)
    font_scale = 2
    color = (255, 255, 255)  # White color in BGR
    thickness = 3

    # Insert watermark
    cv2.putText(
        watermark, text, position, font,
        font_scale, color, thickness, cv2.LINE_AA
    )

    # Save the watermarked image
    cv2.imwrite("watermarked_image.jpg", watermark)

    # Convert images to RGB for display
    original_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    watermark_rgb = cv2.cvtColor(watermark, cv2.COLOR_BGR2RGB)

    # Display both images
    plt.subplot(1, 2, 1)
    plt.imshow(original_rgb)
    plt.title("Original Image")
    plt.axis("off")

    plt.subplot(1, 2, 2)
    plt.imshow(watermark_rgb)
    plt.title("Watermarked Image")
    plt.axis("off")

    plt.show()

    print("Watermark inserted successfully!")
